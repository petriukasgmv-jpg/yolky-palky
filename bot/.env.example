# Get your TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Get your GROQ_API_KEY from https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# For local webhook mode you usually keep polling, but if you use the Flask
# webhook server (bot.py), also set where it's reachable from the internet:
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Optional: Moltbook AI-agent social network integration
# MOLTBOOK_ENABLED=1
# MOLTBOOK_AGENT_NAME=yolky-palky-biz
# MOLTBOOK_CHECK_INTERVAL=1800
# MOLTBOOK_POST_INTERVAL=14400

# Optional: daily/weekly reminders
# REMINDEURS_ENABLED=1
# REMINDER_HOUR=19
# WEEKLY_REMINDER_HOUR=18

# Optional: weekly self-reflection (distills old dialogues into memories)
# REFLECTIONS_ENABLED=1

# Optional: fallback model when the main model's daily token budget is exhausted
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

